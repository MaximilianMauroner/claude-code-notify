{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/claude-code-notify/hooks/notify.sh\"",
            "timeout": 15,
            "async": true,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/claude-code-notify/hooks/notify.sh\"",
            "timeout": 15,
            "async": true,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/claude-code-notify/hooks/notify.sh\"",
            "timeout": 15,
            "async": true,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
